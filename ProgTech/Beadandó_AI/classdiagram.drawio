        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Main {\n        +main(String[])$ void\n    }\n\n    class Reader {\n        +readGame(String)$ GameData\n        +readDice(String)$ Queue~Integer~\n        -parseTile(String)$ Tile\n        -parsePlayer(String)$ Player\n    }\n\n    class GameData {\n        +List~Tile~ tiles\n        +List~Player~ players\n    }\n\n    class Game {\n        -Board board\n        -Dice dice\n        -List~Player~ players\n        +run() Player\n        -playRound() void\n        -takeTurn(Player) void\n        -isOver() boolean\n        +getWinner() Player\n    }\n\n    class Board {\n        -List~Tile~ tiles\n        +size() int\n        +getTile(int) Tile\n        +nextPosition(int, int) int\n    }\n\n    class Dice {\n        &lt;&lt;interface&gt;&gt;\n        +roll() int\n    }\n\n    class RandomDice {\n        -Random random\n        +roll() int\n    }\n\n    class ScriptedDice {\n        -Queue~Integer~ rolls\n        +roll() int\n    }\n\n    class Player {\n        &lt;&lt;abstract&gt;&gt;\n        #String name\n        #int money = 10000\n        #int position\n        #boolean active\n        #List~Property~ properties\n        +moveTo(int) void\n        +receive(int) void\n        +pay(int) boolean\n        +payTo(Player, int) boolean\n        +canAfford(int) boolean\n        +addProperty(Property) void\n        +goBankrupt() void\n        +startRound() void\n        +tryToBuy(int) boolean\n        #wantsToBuy(int)* boolean\n        +toString() String\n    }\n\n    class Greedy {\n        #wantsToBuy(int) boolean\n    }\n\n    class Careful {\n        -int budget\n        +startRound() void\n        #wantsToBuy(int) boolean\n    }\n\n    class Tactical {\n        -boolean skipNext\n        #wantsToBuy(int) boolean\n    }\n\n    class Tile {\n        &lt;&lt;abstract&gt;&gt;\n        +onStep(Player)* void\n    }\n\n    class Property {\n        +int BUY_COST = 1000$\n        +int BUILD_COST = 4000$\n        +int RENT = 500$\n        +int RENT_WITH_HOUSE = 2000$\n        -Player owner\n        -boolean hasHouse\n        +onStep(Player) void\n        -getRent() int\n        +release() void\n    }\n\n    class Service {\n        -int fee\n        +onStep(Player) void\n    }\n\n    class Lucky {\n        -int reward\n        +onStep(Player) void\n    }\n\n    Player &lt;|-- Greedy\n    Player &lt;|-- Careful\n    Player &lt;|-- Tactical\n    Tile &lt;|-- Property\n    Tile &lt;|-- Service\n    Tile &lt;|-- Lucky\n    Dice &lt;|.. RandomDice\n    Dice &lt;|.. ScriptedDice\n\n    Game *-- Board\n    Game o-- Dice\n    Game o-- \&quot;*\&quot; Player : players\n    Board *-- \&quot;1..*\&quot; Tile : tiles\n    Property --&gt; \&quot;0..1\&quot; Player : owner\n    Player o-- \&quot;*\&quot; Property : owns\n\n    Main ..&gt; Reader\n    Main ..&gt; Game\n    Reader ..&gt; GameData : creates\n    GameData --&gt; \&quot;*\&quot; Tile\n    GameData --&gt; \&quot;*\&quot; Player\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="lJ9w6ZL9T57hvSlM_O7H-1">
