        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Game {\n    -Board board\n    -List~Player~ players\n    -Dice dice\n    +Game(String file, Dice dice)\n    +run() Player\n    -playTurn(Player p)\n    -activeCount() int\n  }\n  class Board {\n    -List~Field~ fields\n    +getField(int i) Field\n    +size() int\n  }\n  class Field {\n    &lt;&lt;abstract&gt;&gt;\n    +onStep(Player p)*\n  }\n  class Property {\n    +PRICE = 1000$\n    +HOUSE_PRICE = 4000$\n    -Player owner\n    -boolean hasHouse\n    +onStep(Player p)\n    +reset()\n  }\n  class Service {\n    -int fee\n    +onStep(Player p)\n  }\n  class Lucky {\n    -int prize\n    +onStep(Player p)\n  }\n  class Player {\n    &lt;&lt;abstract&gt;&gt;\n    -String name\n    -int money\n    -int position\n    -boolean out\n    -List~Property~ properties\n    +move(int steps, int size)\n    +pay(int amount, Player to) boolean\n    +receive(int amount)\n    +buy(Property p, int price)\n    +startTurn()\n    +wantsToBuy(int price)* boolean\n    +goBankrupt()\n  }\n  class Greedy {\n    +wantsToBuy(int price) boolean\n  }\n  class Careful {\n    -int budget\n    +startTurn()\n    +wantsToBuy(int price) boolean\n  }\n  class Tactical {\n    -int chances\n    +wantsToBuy(int price) boolean\n  }\n  class Dice {\n    &lt;&lt;interface&gt;&gt;\n    +roll() int\n  }\n  class RandomDice {\n    +roll() int\n  }\n  class FileDice {\n    -Queue~Integer~ rolls\n    +FileDice(String file)\n    +roll() int\n  }\n  Game *-- \&quot;1\&quot; Board\n  Game o-- \&quot;2..*\&quot; Player\n  Game --&gt; \&quot;1\&quot; Dice\n  Board *-- \&quot;1..*\&quot; Field\n  Field &lt;|-- Property\n  Field &lt;|-- Service\n  Field &lt;|-- Lucky\n  Player &lt;|-- Greedy\n  Player &lt;|-- Careful\n  Player &lt;|-- Tactical\n  Dice &lt;|.. RandomDice\n  Dice &lt;|.. FileDice\n  Property --&gt; \&quot;0..1\&quot; Player : owner&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="eUJ1M1rg5F9ZOJuplcIK-1">
