        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n    class Amoba {\n        -player1NameField : JTextField\n        -player2NameField : JTextField\n        -startPanel : JPanel\n        -game : Game\n        -cellButtons : JButton[][]\n        -statusLabel : JLabel\n        +Amoba()\n        -createPlayerPanel(name : String, field : JTextField) JPanel\n        -showStartScreen() void\n        -startNewGame(size : int) void\n        -handleCellClick(row : int, col : int) void\n        -refreshBoard() void\n        -updateStatus() void\n        -nameOrDefault(field : JTextField, defaultName : String) String\n        +main(args : String[])$ void\n    }\n    class Game {\n        -board : Board\n        -players : Player[]\n        -currentIndex : int\n        -random : Random\n        -lastRemovedCount : int\n        -lastResult : MoveResult\n        +Game(size : int, name1 : String, name2 : String)\n        +getSize() int\n        +getCell(row : int, col : int) char\n        +isEmpty(row : int, col : int) boolean\n        +getCurrentPlayerName() String\n        +getCurrentPlayerSymbol() char\n        +getLastRemovedCount() int\n        +isWon() boolean\n        +isDraw() boolean\n        +makeMove(row : int, col : int) boolean\n        -getCurrentPlayer() Player\n        -removeRandomMarks(symbol : char, count : int, keepRow : int, keepCol : int) void\n    }\n    class Board {\n        +EMPTY : char$\n        -size : int\n        -cells : char[][]\n        +Board(size : int)\n        +getSize() int\n        +getCell(row : int, col : int) char\n        +isEmpty(row : int, col : int) boolean\n        +place(row : int, col : int, symbol : char) void\n        +clear(row : int, col : int) void\n        +isFull() boolean\n        +longestLineThrough(row : int, col : int) int\n        -countInDirection(row : int, col : int, dRow : int, dCol : int, symbol : char) int\n        -isInside(row : int, col : int) boolean\n    }\n    class Player {\n        -name : String\n        -symbol : char\n        +Player(name : String, symbol : char)\n        +getName() String\n        +getSymbol() char\n    }\n    class MoveResult {\n        &lt;&lt;enumeration&gt;&gt;\n        INVALID\n        CONTINUE\n        WIN\n        DRAW\n    }\n    Amoba --&gt; \&quot;0..1\&quot; Game : game\n    Game *-- \&quot;1\&quot; Board : board\n    Game *-- \&quot;2\&quot; Player : players\n    Game --&gt; \&quot;1\&quot; MoveResult : lastResult&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="VuGFSFXN1OEXIOZG6ziW-1">
